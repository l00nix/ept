#!/bin/sh
# eptrepo - maintain an ept package repository (runs on the host, not on ELKS)
#
# Repository layout:
#   <repo>/index                    generated package list
#   <repo>/desc                     generated list of package descriptions
#   <repo>/pool/<name>/VERSION      package version, one word
#   <repo>/pool/<name>/DESC         (optional) one line description
#   <repo>/pool/<name>/<dest>       each file, at its install path
#                                   e.g. pool/lua/bin/lua -> /bin/lua
# Nightly builds use a second repository of the same layout in <repo>/nightly.
#
# Usage:
#   eptrepo add [-s] [-d <text>] <repo> <name> <version> <file> <dest> ...
#   eptrepo index <repo>
#   eptrepo html <repo> [<recipes>]
#
# If <file> is a directory, everything in it is added below <dest>,
# e.g. "include /usr/include" or "target /". A symlink is published as a
# copy of its target, which is looked up inside the package: /lib/x is the
# package's /lib/x, as it will be on ELKS.
# A package with files that cannot be published (symlinks to something not
# in the package, bad names) is refused and the old one is left as it was;
# with -s those files are reported and skipped instead.
# -d sets the one line description that "ept search" shows; without it the
# package keeps the description it had.
# html writes <repo>/index.html, a home page with instructions and the
# packages of <repo> and <repo>/nightly. EPT_URL is the address it gives for
# the repository, default http://ept.samwarr.dev. From a <recipes> directory
# it takes each package's project link (GIT= of <name>.pkg) and the other
# repositories to list (the file "mirrors", one "<url> <description>" each).

set -e

# The oldest ept that can use a repository made by this script. It goes into
# the index as "#min <version>"; an older ept then updates itself before it
# installs anything. Raise it when the repository starts to need a newer ept.
MINEPT=1.8

usage()
{
	sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'
	exit 1
}

die()
{
	echo "eptrepo: $*" >&2
	exit 1
}

checkword()
{
	case "$1" in
	""|*[!A-Za-z0-9._/+-]*) die "'$1': only letters, digits and . _ + - allowed";;
	esac
}

index()
{
	repo=$1
	[ -d "$repo/pool" ] || die "$repo/pool: no such directory"
	out=$repo/.index.$$		# unique, so concurrent runs cannot clobber each other
	echo "#ept1" > "$out"
	echo "#min $MINEPT" >> "$out"
	: > "$out.desc"
	npkg=0
	nfile=0
	for dir in "$repo"/pool/*/; do
		[ -d "$dir" ] || continue
		name=`basename "$dir"`
		checkword "$name"
		[ -f "$dir/VERSION" ] || die "$name: missing VERSION file"
		version=`cat "$dir/VERSION"`
		checkword "$version"
		files=`cd "$dir" && find . -type f ! -path ./VERSION ! -path ./DESC | LC_ALL=C sort`
		[ "$files" ] || die "$name: package has no files"
		for f in $files; do
			dest=${f#.}
			checkword "$dest"
			sum=`md5sum "$dir/$f" | cut -d' ' -f1`
			size=`wc -c < "$dir/$f" | tr -d ' '`
			if [ -x "$dir/$f" ]; then mode=755; else mode=644; fi
			echo "$name $version $sum $size $mode $dest" >> "$out"
			nfile=`expr $nfile + 1`
		done
		[ -s "$dir/DESC" ] && echo "$name `head -1 "$dir/DESC"`" >> "$out.desc"
		npkg=`expr $npkg + 1`
	done
	echo "#end" >> "$out"
	mv "$out.desc" "$repo/desc"
	mv "$out" "$repo/index"
	echo "$repo/index: $npkg packages, $nfile files"
}

# note <message>: report a file that cannot be published
note()
{
	echo "eptrepo: $*" >&2
	echo x >> "$stage.bad"
}

# addtree <dir> <dest>: copy the files and symlinks of a tree into the
# staging directory, below <dest>
addtree()
{
	mkdir -p "$stage$2"
	(cd "$1" && d=$stage${2%/} find . \( -type f -o -type l \) -exec sh -c '
		for f; do
			mkdir -p "$d/${f%/*}" && cp -pP "$f" "$d/$f" || exit 1
		done' sh {} +)
}

# Replace the symlinks in the staging directory by copies of what they point
# to. The staging directory is taken as the root, as it will be on ELKS, so
# /lib/x means <stage>/lib/x and never a file of this host. A link to a link
# is resolved in a later pass; what is left after that cannot be published.
resolvelinks()
{
	pass=0
	while [ $pass -lt 10 ]; do
		pass=`expr $pass + 1`
		find "$stage" -type l > "$stage.list"
		[ -s "$stage.list" ] || return 0
		progress=
		while IFS= read -r l; do
			[ -L "$l" ] || continue
			t=`readlink "$l"`
			case "$t" in
			/*) t=$stage$t;;
			*)  t=`dirname "$l"`/$t;;
			esac
			r=`readlink -f "$t" 2>/dev/null` || continue
			case "$r" in "$stage"/*) ;; *) continue;; esac
			case "$l/" in "$r"/*) continue;; esac	# points to its own parent
			if [ -f "$r" ]; then
				rm "$l"
				cp -p "$r" "$l"
			elif [ -d "$r" ]; then
				rm "$l"
				cp -RpP "$r" "$l"
			else
				continue
			fi
			progress=1
		done < "$stage.list"
		[ "$progress" ] || break
	done
	find "$stage" -type l > "$stage.list"
	while IFS= read -r l; do
		note "${l#"$stage"} -> `readlink "$l"`: symlink target is not in the package"
		rm -f "$l"
	done < "$stage.list"
}

# Remove what the index cannot list: names with other characters than
# checkword allows, and anything that is not a regular file.
dropbad()
{
	find "$stage" -mindepth 1 -name '*[!A-Za-z0-9._+-]*' -prune -print > "$stage.list"
	while IFS= read -r f; do
		note "${f#"$stage"}: name has characters other than letters, digits and . _ + -"
	done < "$stage.list"
	find "$stage" -mindepth 1 -name '*[!A-Za-z0-9._+-]*' -prune -exec rm -rf {} +
	find "$stage" ! -type f ! -type d > "$stage.list"
	while IFS= read -r f; do
		note "${f#"$stage"}: not a regular file"
		rm -f "$f"
	done < "$stage.list"
}

add()
{
	skip= desc=
	while :; do
		case "$1" in
		-s) skip=1; shift;;
		-d) [ $# -ge 2 ] || usage; desc=$2; shift 2;;
		*)  break;;
		esac
	done
	case "$desc" in *"
"*) die "the description must be one line";; esac
	[ $# -ge 5 ] || usage
	repo=$1 name=$2 version=$3
	shift 3
	checkword "$name"
	checkword "$version"
	# The package is put together in a staging directory and only replaces
	# the published one when it is complete.
	mkdir -p "$repo/pool"
	stage=`cd "$repo" && pwd -P`/.add.$$
	trap 'rm -rf "$stage" "$stage.list" "$stage.bad"' EXIT
	rm -rf "$stage"
	mkdir "$stage"
	while [ $# -ge 2 ]; do
		case "$2" in /*) ;; *) die "$2: destination must be an absolute path";; esac
		checkword "$2"
		if [ -d "$1" ]; then
			addtree "$1" "$2"
		else
			[ -f "$1" ] || die "$1: no such file"
			mkdir -p "$stage`dirname "$2"`"
			cp -pL "$1" "$stage$2"
		fi
		shift 2
	done
	[ $# -eq 0 ] || usage
	resolvelinks
	dropbad
	if [ -s "$stage.bad" ]; then
		n=`wc -l < "$stage.bad" | tr -d ' '`
		[ "$skip" ] || die "$name not changed: $n files cannot be published (-s skips them)"
		echo "eptrepo: $name: $n files skipped" >&2
	fi
	[ "`find "$stage" -type f | head -1`" ] || die "$name: no files to publish"
	# written last, so a copied tree cannot replace it
	echo "$version" > "$stage/VERSION"
	if [ "$desc" ]; then
		echo "$desc" > "$stage/DESC"
	elif [ -f "$repo/pool/$name/DESC" ]; then
		cp "$repo/pool/$name/DESC" "$stage/DESC"
	else
		rm -f "$stage/DESC"
	fi
	rm -rf "$repo/pool/$name"
	mv "$stage" "$repo/pool/$name"
	index "$repo"
}

# Home page for people who open the repository in a browser. Plain HTML that
# old browsers (ELKSWeb, Lynx) can show; the style block is only a nicety.
html()
{
	repo=$1 recipes=$2 mirrors=/dev/null srcs=/dev/null
	[ -f "$repo/index" ] || die "$repo/index: no package list, run eptrepo index first"
	if [ -n "$recipes" ] && [ -d "$recipes" ]; then
		if [ -f "$recipes/mirrors" ]; then mirrors=$recipes/mirrors; fi
		# "<name> <web address>" for each recipe with an http(s) GIT=
		srcs=$repo/.src.$$
		for f in "$recipes"/*.pkg; do
			[ -f "$f" ] || continue
			g=`sed -n 's/^GIT=//p' "$f" | head -1 | tr -d "\"'"`
			case "$g" in
			http://*|https://*) echo "`basename "$f" .pkg` ${g%.git}" ;;
			esac
		done > "$srcs"
	fi
	url=${EPT_URL:-http://ept.samwarr.dev}
	sdesc=/dev/null nindex=/dev/null ndesc=/dev/null
	if [ -f "$repo/desc" ]; then sdesc=$repo/desc; fi
	if [ -f "$repo/nightly/index" ]; then nindex=$repo/nightly/index; fi
	if [ -f "$repo/nightly/desc" ]; then ndesc=$repo/nightly/desc; fi
	hasept=`awk '$1 == "ept" && $6 == "/bin/ept" { print "yes"; exit }' "$repo/index"`
	out=$repo/.index.html.$$
	{
	cat <<EOF
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html><head>
<meta http-equiv="Content-Type" content="text/html; charset=us-ascii">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ept - ELKS Package Tool</title>
<style type="text/css"><!--
body { max-width: 46em; margin: 1em auto; padding: 0 1em; font-family: sans-serif; line-height: 1.45; }
pre { background: #f0f0f0; padding: .5em .75em; overflow-x: auto; }
h3 { margin-bottom: .2em; }
@media (prefers-color-scheme: dark) {
  body { background: #161616; color: #ddd; }
  a { color: #8ab4f8; }
  pre { background: #262626; }
}
--></style>
</head><body>
<h1>ept - ELKS Package Tool</h1>
<p>ept is a small package manager for <a href="https://github.com/ghaerr/elks">ELKS</a>,
Linux for 8086-class PCs. It downloads programs from a plain HTTP repository like this
one, checks them, and keeps them up to date.</p>
EOF
	if [ "$url" = http://ept.samwarr.dev ]; then
		cat <<EOF
<p>This is the main ept repository, the one ept uses out of the box. Every day it builds
packages from source, so they track each project's latest release and latest code.</p>
EOF
	else
		cat <<EOF
<p>This is the repository at <tt>$url</tt>.</p>
EOF
	fi
	cat <<EOF

<h2>Getting started</h2>
EOF
	if [ "$url" = http://ept.samwarr.dev ]; then
		cat <<EOF
<p>With networking running (<tt>net start</tt>):</p>
<pre>ept update
ept list</pre>
EOF
	else
		cat <<EOF
<p>Make this the first <tt>REPO=</tt> line of <tt>/etc/ept.cfg</tt>, then with
networking running (<tt>net start</tt>):</p>
<pre>REPO=$url</pre>
<pre>ept update
ept list</pre>
EOF
	fi
	if [ "$hasept" ]; then
		cat <<EOF
<p>If your ELKS does not have ept yet, download it first. <tt>ept install -r ept</tt>
then checks <tt>/bin/ept</tt> against the package list and records it as installed,
so <tt>ept upgrade</tt> keeps it current:</p>
<pre>urlget $url/pool/ept/bin/ept &gt; /bin/ept
chmod 755 /bin/ept
ept install -r ept</pre>
EOF
	fi
	cat <<'EOF'

<h2>Using ept</h2>
<pre>ept update                       fetch the package lists
ept list [-n]                    show available and installed packages
ept search [-n] [&lt;text&gt;]         find packages by name or description
ept install [-n] [-r] &lt;pkg&gt; ...  install or repair packages
ept upgrade [-y]                 update all installed packages
ept remove &lt;pkg&gt; ...             remove packages</pre>
<p><tt>-n</tt> uses nightly builds of the latest code instead of releases. A package
installed with <tt>-n</tt> stays on nightlies until it is installed again without it.
<tt>-r</tt> checks every file of a package on disk and fetches the ones that differ.
<tt>-y</tt> skips the question before installing or upgrading.</p>

<h2>Packages</h2>
EOF
	awk '
	function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); return s }
	function kb(n) { return int((n + 1023) / 1024) "K" }
	/^#/ { next }
	FILENAME == ARGV[5] { src[$1] = $2; next }
	FILENAME == ARGV[1] || FILENAME == ARGV[3] {
		if (NF != 6) next
		c = FILENAME == ARGV[1] ? "s" : "n"
		if (!($1 in seen)) { seen[$1] = 1; names[++n] = $1 }
		ver[c, $1] = $2
		size[c, $1] += $4
		next
	}
	{	# a description line, the release one first
		name = $1
		if (name in desc) next
		sub(/^[^ ]+ */, "")
		desc[name] = $0
	}
	END {
		for (i = 2; i <= n; i++)
			for (j = i; j > 1 && names[j - 1] > names[j]; j--) {
				t = names[j]; names[j] = names[j - 1]; names[j - 1] = t
			}
		printf "<p>%d package%s. Releases are built from each project%ss version tags,\n", n, n == 1 ? "" : "s", "\047"
		print "nightlies from its latest code.</p>"
		for (i = 1; i <= n; i++) {
			p = names[i]
			print "<h3>" p "</h3>"
			if (p in desc || p in src) {
				printf "<p>%s", p in desc ? esc(desc[p]) : ""
				if (p in src) {
					s = src[p]; t = s; sub(/^https?:\/\//, "", t)
					gsub(/"/, "%22", s)
					printf "%sProject: <a href=\"%s\">%s</a>", p in desc ? "<br>\n" : "", esc(s), esc(t)
				}
				print "</p>"
			}
			printf "<pre>"
			if (("s", p) in ver)
				printf "%-30s release %s, %s\n", "ept install " p, ver["s", p], kb(size["s", p])
			if (("n", p) in ver)
				printf "%-30s nightly %s, %s\n", "ept install -n " p, ver["n", p], kb(size["n", p])
			print "</pre>"
		}
	}' "$repo/index" "$sdesc" "$nindex" "$ndesc" "$srcs"
	cat <<EOF

<h2>Other repositories</h2>
<p>ept reads its repositories from <tt>REPO=</tt> lines in <tt>/etc/ept.cfg</tt>, up to 8.
The first is the primary, and only it can update ept itself. For any other package a
later line overrides an earlier one, so add extra repositories below the primary.
<b>Every repository you list can install and replace files anywhere on your system,
so only add ones you trust.</b></p>
<p>Other repositories are run independently and may carry different or older builds of
the same packages. ept installs the version a repository lists, even an older one, so a
repository made primary can also replace ept itself with an older version.</p>
EOF
	# the other repositories, leaving out this one
	awk -v self="$url" '
	BEGIN { sub(/\/+$/, "", self) }
	function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s); return s }
	/^[ \t]*(#|$)/ { next }
	{
		u = $1; sub(/\/+$/, "", u)
		if (u == self || u !~ /^http:\/\//) next
		d = $0; sub(/^[ \t]*[^ \t]+[ \t]*/, "", d)
		if (!n++) print "<p>Known repositories:</p>\n<ul>"
		printf "<li><a href=\"%s\">%s</a>%s</li>\n", esc(u), esc(u), d == "" ? "" : " - " esc(d)
	}
	END { if (n) print "</ul>" }' "$mirrors"
	cat <<EOF

<h2>Adding a package</h2>
<p>Packages are built from source by the repository's build server. To add one, open a
pull request with a recipe in <a href="https://github.com/sammothxc/ept/tree/main/recipes">recipes/</a>:
a few lines naming the git repository, the build command and where the files install.
After that it keeps itself up to date: plain version tags such as <tt>v1.2</tt> become
releases, and new commits become nightlies. Keep installed file names to 8.3 characters
so they also work on FAT disks.</p>

<hr>
<p>Every file is checked against the size and MD5 in the package list before it
replaces anything. ELKS has no TLS, so this catches damaged downloads, not tampering.</p>
<p><a href="/index">Package list</a> | <a href="/nightly/index">Nightly list</a> |
<a href="/pool/">Browse files</a> | <a href="https://github.com/sammothxc/ept">ept on GitHub</a><br>
Updated `date -u '+%Y-%m-%d %H:%M UTC'`.</p>
</body></html>
EOF
	} > "$out"
	mv "$out" "$repo/index.html"
	if [ "$srcs" != /dev/null ]; then rm -f "$srcs"; fi
	echo "$repo/index.html written"
}

case "$1" in
add)	shift; add "$@";;
index)	[ $# -eq 2 ] || usage; index "$2";;
html)	[ $# -eq 2 ] || [ $# -eq 3 ] || usage; html "$2" "$3";;
*)	usage;;
esac
