# elksweb: graphical web browser for ELKS
DESC="Graphical web browser"
GIT=https://github.com/l00nix/ELKSWeb.git
# Track 0.5 development builds; main remains the frozen 0.4 baseline.
BRANCH=codex/0.5dev
# Do not promote the v0.5dev1 prerelease tag to the stable catalogue.
# Existing stable packages remain available; revisit this at promotion.
STABLE=no
BUILD="ELKSWEB_ELKS=$ELKS sh toolchain/build-external.sh"
FILES="build/elksweb:/bin/elksweb
share/welcome.htm:/lib/elksweb/welcome.htm
share/elksweb.gif:/lib/elksweb/elksweb.gif
share/color.htm:/lib/elksweb/color.htm
share/elkswebc.gif:/lib/elksweb/elkswebc.gif
share/chart.gif:/lib/elksweb/chart.gif
share/license.txt:/lib/elksweb/license.txt
share/logo-source.txt:/lib/elksweb/logo-src.txt"
