# Native system information for ELKS / 8086; logos are embedded.
# Releases remain unpublished drafts; publish nightlies only.
# All installed path components fit ELKS FAT 8.3 names.
DESC="Native ELKS system-information utility"
GIT=https://github.com/l00nix/elksfetch.git
STABLE=no
BUILD="ELKSFETCH_ELKS=$ELKS sh toolchain/build-external.sh"
FILES="build/elksftch:/bin/elksftch
README.md:/lib/elksftch/readme
LICENSE:/lib/elksftch/license"
